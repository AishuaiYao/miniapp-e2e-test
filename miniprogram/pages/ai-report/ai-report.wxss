page {
  background: linear-gradient(180deg, #e0f2fe 0%, #f0f9ff 40%, #fdf4ff 100%);
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 人物画像卡 ===== */
.portrait-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #4f46e5 0%, #8b5cf6 55%, #d946ef 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(139, 92, 246, 0.35);
}

.portrait-card::before,
.portrait-card::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.portrait-card::before {
  width: 260rpx;
  height: 260rpx;
  top: -100rpx;
  right: -80rpx;
}

.portrait-card::after {
  width: 180rpx;
  height: 180rpx;
  bottom: -70rpx;
  left: -50rpx;
}

.portrait-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.portrait-avatar {
  flex-shrink: 0;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: 6rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.portrait-avatar-char {
  font-size: 56rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #4f46e5, #d946ef);
  -webkit-background-clip: text;
  color: transparent;
}

.portrait-id {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.portrait-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.portrait-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.portrait-tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.portrait-tag {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.portrait-stats {
  position: relative;
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.stat-expense {
  color: #fecdd3;
}

.stat-income {
  color: #a7f3d0;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 40rpx;
  gap: 28rpx;
}

.loading-ring {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8b5cf6;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: #64748b;
}

/* 错误 */
.error-wrap {
  padding: 120rpx 0 40rpx;
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #94a3b8;
}

/* 画像解读 */
.section-title {
  margin: 40rpx 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #334155;
}

.report-list {
  margin-top: 8rpx;
}

.report-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(139, 92, 246, 0.12);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.report-badge {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #8b5cf6, #d946ef);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.35);
}

.report-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #a78bfa;
  margin-top: 16rpx;
  margin-left: 17rpx;
}

.report-content {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.75;
  color: #334155;
}

/* 底部重新生成 */
.footer {
  margin-top: 32rpx;
}

.regenerate-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #d946ef);
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.35);
  padding: 0;
}

.regenerate-btn::after {
  border: none;
}

.regenerate-btn:active {
  transform: scale(0.98);
}
