<view class="page">
  <view class="bg-gradient"></view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navTotalHeight}}px;">
    <view class="nav-bar-left" bind:tap="openDrawer">
      <view class="hamburger">
        <view class="hamburger-line"></view>
        <view class="hamburger-line"></view>
        <view class="hamburger-line"></view>
      </view>
    </view>
    <view class="nav-bar-title">发现</view>
    <view class="nav-bar-right"></view>
  </view>

  <!-- 顶部筛选区：搜索 + 分类 + 排序 -->
  <view class="top-filter-area" style="top: {{navTotalHeight}}px; height: {{filterAreaHeight}}px;">
    <!-- 搜索框 -->
    <view class="search-bar">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索博文" placeholder-class="search-placeholder" disabled />
      </view>
    </view>

    <!-- 分类选择条 -->
    <view class="category-bar">
      <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="category-item {{activeCategory === item.key ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="key"
          bind:tap="onCategoryTap"
          data-key="{{item.key}}"
        >
          <text class="category-name">{{item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 排序栏 -->
    <view class="sort-bar">
      <view
        class="sort-item {{activeSort === item.key ? 'active' : ''}}"
        wx:for="{{sortOptions}}"
        wx:key="key"
        bind:tap="onSortTap"
        data-key="{{item.key}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 博文列表 -->
  <scroll-view scroll-y class="content-scroll" style="top: {{navTotalHeight + filterAreaHeight}}px;">
    <view class="post-list">
      <view class="post-card" wx:for="{{posts}}" wx:key="_id" bind:tap="onPostTap" data-id="{{item._id}}">
        <!-- 作者信息 -->
        <view class="post-header">
          <view class="author-info">
            <image wx:if="{{item.authorAvatarUrl}}" class="author-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="author-avatar author-avatar-default">{{item.authorNickName ? item.authorNickName[0] : '?'}}</view>
            <view class="author-meta">
              <text class="author-name">{{item.authorNickName}}</text>
              <view class="post-source">
                <text class="post-source-icon">📒</text>
                <text class="post-source-name">{{item.notebookName}}</text>
              </view>
            </view>
          </view>
          <view class="post-header-right">
            <view class="post-cat-badge" style="background: {{item.coverColor}};">{{item.mainCategory}}</view>
            <view class="post-del" wx:if="{{item.isOwner}}" catch:tap="onDeletePost" data-id="{{item._id}}">删除</view>
          </view>
        </view>

        <!-- 博文内容 -->
        <view class="post-body">
          <text class="post-title">{{item.title}}</text>
          <text class="post-summary">{{item.content}}</text>
        </view>

        <!-- 博文配图 -->
        <view class="post-images" wx:if="{{item.imageUrls && item.imageUrls.length > 0}}">
          <image
            wx:for="{{item.imageUrls}}"
            wx:for-item="img"
            wx:key="*this"
            class="post-image"
            src="{{img}}"
            mode="aspectFill"
            catch:tap="onPreviewEditImage"
            data-url="{{img}}"
          ></image>
        </view>

        <!-- 消费统计 -->
        <view class="post-stats">
          <view class="stat-pill">
            <text class="stat-pill-label">总支出</text>
            <text class="stat-pill-value">¥{{item.totalExpense}}</text>
          </view>
          <view class="stat-pill">
            <text class="stat-pill-label">记录</text>
            <text class="stat-pill-value">{{item.recordCount}} 笔</text>
          </view>
          <text class="post-time">{{item.createdAt}}</text>
        </view>

        <!-- 转评赞 -->
        <view class="post-actions">
          <view class="post-action {{item.liked ? 'liked' : ''}}" catch:tap="onLikeTap" data-id="{{item._id}}">
            <text class="action-icon">{{item.liked ? '❤️' : '🤍'}}</text>
            <text class="action-count">{{item.likeCount}}</text>
          </view>
          <view class="post-action" catch:tap="onCommentTap" data-id="{{item._id}}">
            <text class="action-icon">💬</text>
            <text class="action-count">{{item.commentCount}}</text>
          </view>
          <button class="post-action share-btn" open-type="share" data-id="{{item._id}}" catch:tap="onShareTap">
            <text class="action-icon">↗</text>
            <text class="action-count">{{item.shareCount}}</text>
          </button>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-section" wx:if="{{posts.length === 0 && !loadingPosts}}">
        <view class="empty-illustration">📭</view>
        <text class="empty-text">还没有博文</text>
        <text class="empty-hint">点击右下角发布第一篇博文吧</text>
      </view>

      <!-- 加载中 -->
      <view class="loading-section" wx:if="{{loadingPosts}}">
        <text>加载中...</text>
      </view>
    </view>

    <view style="height: 60rpx;"></view>
  </scroll-view>

  <!-- 右下角发布按钮 -->
  <view class="fab-publish" bind:tap="showPublishPopup">+ 发布</view>

  <!-- 发布博文弹窗 -->
  <view class="publish-mask" wx:if="{{showPublish}}" catchtap="closePublish">
    <view class="publish-card" catchtap="onModalStop">
      <!-- 步骤1：选择账本 -->
      <block wx:if="{{publishStep === 'select'}}">
        <text class="publish-title">发布博文</text>
        <text class="publish-desc">选择一个账本，AI 将根据账本记录生成消费分析博文</text>

        <view class="notebook-pick-list">
          <view
            class="notebook-pick-item {{selectedNotebookId === item._id ? 'selected' : ''}}"
            wx:for="{{notebooks}}"
            wx:key="_id"
            bind:tap="onSelectNotebook"
            data-id="{{item._id}}"
          >
            <text class="pick-icon">{{item.isTeam ? '👥' : '👤'}}</text>
            <view class="pick-info">
              <text class="pick-name">{{item.name}}</text>
              <text class="pick-desc">{{item.memberCount}}人 · {{item.isTeam ? '多人账本' : '个人账本'}}</text>
            </view>
            <view class="pick-check" wx:if="{{selectedNotebookId === item._id}}">✓</view>
          </view>
        </view>

        <button
          class="generate-btn {{generating ? 'loading' : ''}}"
          bind:tap="onGenerate"
          disabled="{{generating || !selectedNotebookId}}"
        >
          {{generating ? 'AI 生成中...' : '生成博文'}}
        </button>
      </block>

      <!-- 步骤2：编辑 -->
      <block wx:if="{{publishStep === 'edit'}}">
        <view class="edit-header">
          <text class="publish-title">编辑博文</text>
          <text class="edit-hint">可修改标题、正文和图片，确认后发布</text>
        </view>

        <view class="edit-form">
          <text class="edit-label">标题</text>
          <input
            class="edit-title-input"
            value="{{editTitle}}"
            bindinput="onEditTitleInput"
            placeholder="请输入标题"
            maxlength="40"
          />

          <text class="edit-label">正文</text>
          <textarea
            class="edit-content-input"
            value="{{editContent}}"
            bindinput="onEditContentInput"
            placeholder="请输入正文"
            maxlength="2000"
            auto-height
          ></textarea>

          <view class="edit-images-label" wx:if="{{editImageUrls.length > 0}}">
            <text class="edit-label">配图（来自账本记录，可删除）</text>
            <text class="edit-images-count">{{editImageUrls.length}} 张</text>
          </view>
          <view class="edit-images" wx:if="{{editImageUrls.length > 0}}">
            <view class="edit-image-item" wx:for="{{editImageUrls}}" wx:key="*this">
              <image
                class="edit-image"
                src="{{item}}"
                mode="aspectFill"
                catch:tap="onPreviewEditImage"
                data-url="{{item}}"
              ></image>
              <view class="edit-image-del" catch:tap="onRemoveEditImage" data-index="{{index}}">✕</view>
            </view>
          </view>
        </view>

        <view class="edit-actions">
          <button class="edit-retry-btn" bind:tap="onGenerate" disabled="{{generating}}">重新生成</button>
          <button class="edit-publish-btn" bind:tap="onPublish" disabled="{{publishing}}" loading="{{publishing}}">
            {{publishing ? '发布中...' : '发布'}}
          </button>
        </view>
      </block>

      <view class="publish-cancel" bind:tap="closePublish">取消</view>
    </view>
  </view>

  <!-- 评论弹窗 -->
  <view class="comment-mask" wx:if="{{showComments}}" catchtap="closeComments">
    <view class="comment-card" catchtap="onModalStop">
      <view class="comment-header">
        <text class="comment-title">评论</text>
        <view class="comment-close" bind:tap="closeComments">✕</view>
      </view>

      <!-- 评论列表 -->
      <scroll-view scroll-y class="comment-list">
        <view class="comment-empty" wx:if="{{comments.length === 0 && !loadingComments}}">
          <text>还没有评论，说点什么吧</text>
        </view>

        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <image wx:if="{{item.avatarUrl}}" class="comment-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="comment-avatar comment-avatar-default">{{item.nickName ? item.nickName[0] : '?'}}</view>
          <view class="comment-body">
            <view class="comment-meta">
              <text class="comment-name">{{item.nickName}}</text>
              <view class="comment-del" wx:if="{{item.isOwner}}" catch:tap="onDeleteComment" data-id="{{item._id}}">删除</view>
            </view>
            <text class="comment-content">{{item.content}}</text>
            <view class="comment-reply-btn" catch:tap="onReplyTap" data-id="{{item._id}}" data-openid="{{item.openId}}" data-name="{{item.nickName}}">回复</view>

            <!-- 楼中楼回复 -->
            <view class="reply-list" wx:if="{{item.replies && item.replies.length > 0}}">
              <view class="reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="_id">
                <text class="reply-name">{{reply.nickName}}</text>
                <text class="reply-to" wx:if="{{reply.replyToName}}"> 回复 {{reply.replyToName}}</text>
                <text class="reply-content">：{{reply.content}}</text>
                <view class="comment-del reply-del" wx:if="{{reply.isOwner}}" catch:tap="onDeleteComment" data-id="{{reply._id}}">删除</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 评论输入 -->
      <view class="comment-input-bar">
        <view class="comment-reply-tip" wx:if="{{replyTo}}">
          <text>回复 {{replyTo.name}}</text>
          <view class="reply-cancel" bind:tap="cancelReply">✕</view>
        </view>
        <view class="comment-input-row">
          <input
            class="comment-input"
            value="{{commentInput}}"
            bindinput="onCommentInput"
            placeholder="{{replyTo ? '回复 ' + replyTo.name : '写评论...'}}"
            maxlength="200"
          />
          <view class="comment-send" bind:tap="onSendComment">发送</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 导航抽屉 -->
  <nav-drawer
    visible="{{drawerVisible}}"
    currentPath="/pages/discover/discover"
    bind:close="closeDrawer"
    bind:navigate="onNavigate"
  ></nav-drawer>
</view>
