<view class="page">
  <view class="bg-gradient"></view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-bar-left" bind:tap="openDrawer">
      <view class="hamburger">
        <view class="hamburger-line"></view>
        <view class="hamburger-line"></view>
        <view class="hamburger-line"></view>
      </view>
    </view>
    <view class="nav-bar-title">智能语音记账</view>
    <view class="nav-bar-right"></view>
  </view>

  <scroll-view class="main-scroll" scroll-y="true" style="top: {{navTotalHeight}}px;">

    <!-- 当前账本信息 -->
    <view class="notebook-bar" wx:if="{{hasNotebook}}">
      <image wx:if="{{currentNotebookIcon}}" class="notebook-bar-icon" src="{{currentNotebookIcon}}" mode="aspectFit"></image>
      <text wx:else class="notebook-bar-icon">📒</text>
      <text class="notebook-bar-name">{{currentNotebookName}}</text>
      <text class="notebook-bar-change" bind:tap="goToNotebooks">切换</text>
    </view>

    <!-- 无账本时引导创建 -->
    <view class="no-notebook-card" wx:if="{{!hasNotebook}}">
      <view class="no-notebook-icon">📒</view>
      <text class="no-notebook-text">还没有账本</text>
      <text class="no-notebook-hint">创建账本后才能开始记账</text>
      <button class="btn-create-notebook" bind:tap="goToNotebooks">去创建账本</button>
    </view>

    <!-- ====== 顶部：按住说话 ====== -->
    <view class="section record-section" wx:if="{{hasNotebook}}">

      <!-- 录音状态提示 -->
      <view class="record-status" wx:if="{{recording}}">
        <view class="recording-dot"></view>
        <text>{{recordDuration}}s 后结束</text>
      </view>
      <view class="record-status" wx:elif="{{loading}}">
        <text>{{loadingText}}</text>
      </view>
      <view class="record-status" wx:else>
        <text>说出时间地点效果更好哦</text>
      </view>

      <!-- 大号录音按钮 -->
      <view
        class="record-btn {{recording ? 'recording' : ''}} {{loading ? 'disabled' : ''}}"
        bindtouchstart="onRecordStart"
        bindtouchend="onRecordEnd"
        bindtouchcancel="onRecordEnd"
      >
        <!-- 云雾背景 -->
        <view class="cloud-bg" wx:if="{{!recording}}">
          <view class="cloud-blob cloud-blob-1"></view>
          <view class="cloud-blob cloud-blob-2"></view>
          <view class="cloud-blob cloud-blob-3"></view>
          <view class="cloud-blob cloud-blob-4"></view>
          <view class="cloud-blob cloud-blob-5"></view>
        </view>
        <view class="record-btn-inner">
          <view class="mic-icon">
            <view class="mic-body"></view>
            <view class="mic-stand"></view>
          </view>
          <text class="record-btn-text">{{recording ? '松开' : (loading ? '处理中' : '按住说话')}}</text>
        </view>
        <!-- 录音波纹 -->
        <view class="ripple ripple1" wx:if="{{recording}}"></view>
        <view class="ripple ripple2" wx:if="{{recording}}"></view>
        <view class="ripple ripple3" wx:if="{{recording}}"></view>
      </view>

      <!-- 文本输入按钮 -->
      <view class="text-input-btn" bindtap="onTextInput">
        <text class="text-input-icon">⌨</text>
      </view>
    </view>

    <!-- ====== 中部：ASR 结果 ====== -->
    <view class="section result-section" wx:if="{{asrText}}">
      <view class="result-card asr-card">
        <view class="result-label">
          <text class="label-icon">🎤</text>
          <text>识别结果</text>
          <view class="play-btn-mini {{playingIndex >= 0 ? 'playing' : ''}}" catchtap="onPlayAudio">
            <text>{{playingIndex >= 0 ? '⏸' : '▶'}}</text>
          </view>
        </view>
        <view class="result-content">{{asrText}}</view>
      </view>
    </view>

    <!-- ====== 统计概览 ====== -->
    <view class="section stats-section" wx:if="{{records.length > 0}}">
      <view class="section-title">收支概览</view>
      <view class="section-subtitle" wx:if="{{dateRange}}">{{dateRange}}</view>
      <view class="stats-cards">
        <view class="stat-card income-card">
          <text class="stat-label">收入</text>
          <text class="stat-amount">¥{{totalIncome}}</text>
        </view>
        <view class="stat-card expense-card">
          <text class="stat-label">支出</text>
          <text class="stat-amount">¥{{totalExpense}}</text>
        </view>
        <view class="stat-card balance-card">
          <text class="stat-label">结余</text>
          <text class="stat-amount">¥{{balance}}</text>
        </view>
      </view>

      <!-- 饼状图 -->
    </view>

    <!-- ====== 记账列表 ======-->
    <view class="section list-section" wx:if="{{records.length > 0}}">
      <view class="section-title">记账记录</view>

      <!-- Tab 切换 -->
      <view class="tab-bar">
        <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-tab="all">全部</view>
        <view class="tab {{activeTab === 'expense' ? 'active' : ''}}" bindtap="onTabChange" data-tab="expense">支出</view>
        <view class="tab {{activeTab === 'income' ? 'active' : ''}}" bindtap="onTabChange" data-tab="income">收入</view>
      </view>

      <!-- 记录列表 -->
      <view class="record-list">
        <view class="record-item" wx:for="{{filteredRecords}}" wx:key="id">
          <view class="record-item-left">
            <view class="record-cat-icon {{item.type === 'income' ? 'bg-income' : 'bg-expense'}}">
              {{item.type === 'income' ? '💰' : '🧾'}}
            </view>
            <view class="record-info">
              <view class="record-cat">{{item.category}}{{item.subCategory ? ' · ' + item.subCategory : ''}}</view>
              <view class="record-desc">{{item.description}}</view>
              <view class="record-tags">
                <view class="record-tag" catchtap="onTagTap" data-type="time" data-value="{{item.time}}">{{item.time}}</view>
                <view wx:if="{{item.location}}" class="record-tag" catchtap="onTagTap" data-type="location" data-value="{{item.location}}">📍{{item.location}}</view>
              </view>
            </view>
          </view>
          <view class="record-item-right">
            <text class="record-amount {{item.type === 'income' ? 'text-income' : 'text-expense'}}">
              {{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}
            </text>
            <view class="record-del" catchtap="onDeleteRecord" data-id="{{item.id}}">✕</view>
          </view>
        </view>

        <view class="empty-tip" wx:if="{{filteredRecords.length === 0}}">
          <text>暂无记录</text>
        </view>
      </view>
    </view>

    <!-- ====== 支出分类饼状图 ====== -->
    <view class="section chart-section" wx:if="{{pieData.length > 0}}">
      <view class="section-title">支出分类占比</view>
      <view class="chart-card">
        <view class="chart-container">
          <canvas canvas-id="pieChart" id="pieChart" type="2d" class="pie-canvas"></canvas>
          <!-- 图例 -->
          <view class="chart-legend">
            <view class="legend-item" wx:for="{{pieData}}" wx:key="index">
              <view class="legend-dot" style="background: {{item.color}};"></view>
              <text class="legend-label">{{item.name}}</text>
              <text class="legend-value">¥{{item.value}}</text>
              <text class="legend-percent">{{item.percent}}%</text>
            </view>
            <view class="legend-sub" wx:for="{{pieData}}" wx:key="index" wx:for-item="pie">
              <text class="legend-sub-text" wx:if="{{pie.subText}}">{{pie.name}}{{pie.subText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="section empty-section" wx:if="{{hasNotebook && records.length === 0 && !asrText}}">
      <view class="empty-illustration">📝</view>
      <text class="empty-text">还没有记账记录</text>
      <text class="empty-hint">按住上方按钮说："今天吃饭花了30块"</text>
    </view>

    <view style="height: 60rpx;"></view>
  </scroll-view>

  <!-- 文本输入弹窗 -->
  <view class="text-modal-mask" wx:if="{{textInputVisible}}" catchtap="onTextInputCancel">
    <view class="text-modal-card" catchtap="onModalStop">
      <view class="text-modal-title">文本记账</view>
      <textarea
        class="text-modal-input"
        placeholder="如：刚刚在五道口买枣糕花费19.8元"
        placeholder-class="text-modal-placeholder"
        value="{{textInputValue}}"
        bindinput="onTextInputChange"
        maxlength="200"
        auto-height
        adjust-position="{{true}}"
      ></textarea>
      <view class="text-modal-actions">
        <view class="text-modal-btn text-modal-cancel" catchtap="onTextInputCancel">取消</view>
        <view class="text-modal-btn text-modal-confirm" catchtap="onTextInputConfirm">确认</view>
      </view>
    </view>
  </view>

  <!-- 导航抽屉 -->
  <nav-drawer
    visible="{{drawerVisible}}"
    currentPath="/pages/index/index"
    bind:close="closeDrawer"
    bind:navigate="onNavigate"
  ></nav-drawer>
</view>
