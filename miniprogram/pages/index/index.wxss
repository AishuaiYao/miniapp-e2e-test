.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* ========== 消息列表 ========== */
.msg-list {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 20rpx;
  overflow-y: auto;
}

.msg {
  margin-bottom: 32rpx;
  display: flex;
}

.msg.assistant {
  justify-content: flex-start;
}

.msg.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  position: relative;
}

.bubble-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.bubble-content {
  font-size: 32rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* AI 回答气泡 */
.assistant-bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ASR 识别结果气泡 */
.user-bubble {
  background: #07c160;
  color: #fff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}

.user-bubble .bubble-label {
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 播放按钮 ========== */
.play-btn {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 20rpx 8rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  width: fit-content;
  transition: background 0.2s;
}

.play-btn.playing {
  background: rgba(255, 255, 255, 0.35);
}

/* 播放图标（三角形） */
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 0 10rpx 16rpx;
  border-color: transparent transparent transparent #fff;
  margin-right: 10rpx;
}

/* 停止图标（方形） */
.play-icon.stop-icon {
  width: 18rpx;
  height: 18rpx;
  border-width: 0;
  border-radius: 2rpx;
  background: #fff;
}

.play-text {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 底部录音区域 ========== */
.record-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 24rpx 48rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.record-status {
  height: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-status-text {
  font-size: 26rpx;
  color: #999;
}

.recording-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4d4f;
  margin-right: 12rpx;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
}

/* 大号录音按钮 */
.record-btn {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.35);
  transition: all 0.2s ease;
  user-select: none;
}

.record-btn.recording {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  box-shadow: 0 8rpx 40rpx rgba(255, 77, 79, 0.45);
  transform: scale(1.1);
}

.record-btn.disabled {
  background: linear-gradient(135deg, #ccc 0%, #bbb 100%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 麦克风图标 */
.record-btn-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.mic-icon {
  width: 36rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #fff;
  position: relative;
}

.mic-icon::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #fff;
}

.mic-icon::before {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 16rpx;
  border-radius: 0 0 14rpx 14rpx;
  border: 4rpx solid #fff;
  border-top: none;
  background: transparent;
}

.record-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 录音时长 */
.record-duration {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
}
