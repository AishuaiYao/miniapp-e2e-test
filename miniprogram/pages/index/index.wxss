/* ========== 全局马卡龙风格 + 浅蓝毛玻璃 ========== */

page {
  background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 30%, #fef3f2 70%, #fce7f3 100%);
  min-height: 100vh;
}

.page {
  position: relative;
  min-height: 100vh;
}

.bg-gradient {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at 20% 10%, rgba(186, 230, 253, 0.4), transparent 40%),
              radial-gradient(circle at 80% 80%, rgba(251, 207, 232, 0.3), transparent 40%);
  pointer-events: none;
  z-index: 0;
}

/* ========== 自定义导航栏 ========== */

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: rgba(240, 249, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.nav-bar-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hamburger {
  width: 44rpx;
  height: 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx;
}

.hamburger-line {
  height: 4rpx;
  background: #475569;
  border-radius: 2rpx;
}

.nav-bar-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #475569;
}

.nav-bar-right {
  width: 80rpx;
}

.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  box-sizing: border-box;
}

/* ========== 通用区块 ========== */

.section {
  margin-bottom: 28rpx;
  padding: 0 24rpx;
}

/* ========== 账本信息栏 ========== */

.notebook-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(135, 206, 235, 0.1);
}

.notebook-bar-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.notebook-bar-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.notebook-bar-change {
  font-size: 24rpx;
  color: #38bdf8;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(186, 230, 253, 0.3);
}

.notebook-bar-change:active {
  background: rgba(186, 230, 253, 0.5);
}

/* ========== 无账本引导 ========== */

.no-notebook-card {
  position: relative;
  z-index: 1;
  margin: 40rpx 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 24rpx rgba(135, 206, 235, 0.15);
}

.no-notebook-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-notebook-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.no-notebook-hint {
  display: block;
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 32rpx;
}

.btn-create-notebook {
  width: 320rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #7dd3fc, #38bdf8);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(56, 189, 248, 0.3);
}

.btn-create-notebook::after {
  border: none;
}

.btn-create-notebook:active {
  transform: scale(0.95);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* ========== 毛玻璃卡片基础 ========== */

.result-card,
.stats-cards,
.category-stats,
.record-item {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(135, 206, 235, 0.15);
}

/* ========== 顶部录音区 ========== */

.record-section {
  position: relative;
  text-align: center;
  padding: 20rpx 24rpx 20rpx;
}

.record-status {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

.recording-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fb7185;
  margin-right: 10rpx;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.3); }
}

/* 大号录音按钮 */
.record-btn {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  margin: 0 auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(224, 242, 254, 0.2) 50%, rgba(219, 234, 254, 0.25) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(56, 189, 248, 0.25), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.6), inset 0 -4rpx 16rpx rgba(199, 210, 254, 0.2);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  transition: all 0.25s ease;
}

.record-btn.recording {
  background: linear-gradient(135deg, #fda4af 0%, #fb7185 50%, #f43f5e 100%);
  box-shadow: 0 8rpx 40rpx rgba(244, 63, 94, 0.45);
  transform: scale(1.08);
}

.record-btn.disabled {
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 云雾背景 */
.cloud-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}

.cloud-blob {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  filter: blur(28rpx);
  mix-blend-mode: screen;
}

.cloud-blob-1 {
  background: #f9a8d4;
  top: 20rpx;
  left: 40rpx;
  animation: cloud-move-1 6s ease-in-out infinite;
}

.cloud-blob-2 {
  background: #c4b5fd;
  top: 160rpx;
  left: 180rpx;
  animation: cloud-move-2 7s ease-in-out infinite;
}

.cloud-blob-3 {
  background: #93c5fd;
  top: 80rpx;
  left: 140rpx;
  animation: cloud-move-3 5s ease-in-out infinite;
}

.cloud-blob-4 {
  background: #a5f3fc;
  top: 140rpx;
  left: 30rpx;
  animation: cloud-move-4 6.5s ease-in-out infinite;
}

.cloud-blob-5 {
  background: #fbcfe8;
  top: 40rpx;
  left: 200rpx;
  animation: cloud-move-5 5.5s ease-in-out infinite;
}

@keyframes cloud-move-1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(60rpx, 40rpx) scale(1.15); }
  66% { transform: translate(-30rpx, 80rpx) scale(0.9); }
}

@keyframes cloud-move-2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(-50rpx, -40rpx) scale(1.1); }
  66% { transform: translate(40rpx, 30rpx) scale(1.2); }
}

@keyframes cloud-move-3 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(50rpx, -50rpx) scale(1.25); }
}

@keyframes cloud-move-4 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  40% { transform: translate(70rpx, -30rpx) scale(0.85); }
  70% { transform: translate(-20rpx, 50rpx) scale(1.15); }
}

@keyframes cloud-move-5 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-60rpx, 50rpx) scale(1.2); }
}

/* 文本输入按钮 */
.text-input-btn {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.text-input-btn:active {
  transform: scale(0.92);
}

.text-input-icon {
  font-size: 44rpx;
  color: #a78bfa;
}

.record-btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
  position: relative;
  pointer-events: none;
}

/* 麦克风图标 */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 8rpx;
}

.mic-body {
  width: 48rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.85), rgba(199,210,254,0.65));
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.4), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.7);
}

.mic-stand {
  width: 6rpx;
  height: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.85), rgba(199,210,254,0.65));
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  margin-top: 3rpx;
  border-radius: 0 0 6rpx 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.4);
}

.record-btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  margin-top: 4rpx;
  text-shadow: 0 1rpx 2rpx rgba(139, 92, 246, 0.9), 0 0 10rpx rgba(139, 92, 246, 0.5), 0 0 4rpx rgba(255, 255, 255, 0.8);
}

/* 录音波纹 */
.ripple {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 3rpx solid rgba(251, 113, 133, 0.4);
  animation: ripple-anim 1.5s ease-out infinite;
}

.ripple1 { width: 320rpx; height: 320rpx; animation-delay: 0s; }
.ripple2 { width: 320rpx; height: 320rpx; animation-delay: 0.5s; }
.ripple3 { width: 320rpx; height: 320rpx; animation-delay: 1s; }

@keyframes ripple-anim {
  0% { width: 320rpx; height: 320rpx; opacity: 0.6; }
  100% { width: 480rpx; height: 480rpx; opacity: 0; }
}

/* ========== ASR + AI 结果卡片 ========== */

.result-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-card {
  padding: 24rpx 28rpx;
}

.result-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.label-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.play-btn-mini {
  margin-left: auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(186, 230, 253, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.play-btn-mini.playing {
  background: rgba(251, 207, 232, 0.6);
}

.result-content {
  font-size: 32rpx;
  color: #334155;
  line-height: 1.6;
  word-break: break-all;
}

/* ========== 统计概览 ========== */

.stats-cards {
  display: flex;
  padding: 20rpx;
  gap: 12rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
}

.income-card {
  background: rgba(187, 247, 208, 0.5);
}

.expense-card {
  background: rgba(254, 215, 170, 0.5);
}

.balance-card {
  background: rgba(219, 234, 254, 0.5);
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.stat-amount {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
}

/* ========== 分类统计 ========== */

.category-stats {
  padding: 8rpx 24rpx;
  margin-top: 16rpx;
}

.cat-stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.5);
}

.cat-stat-item:last-child {
  border-bottom: none;
}

.cat-stat-left {
  display: flex;
  align-items: center;
}

.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.cat-income { background: #86efac; }
.cat-expense { background: #fdba74; }

.cat-name {
  font-size: 28rpx;
  color: #475569;
}

.cat-stat-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cat-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.cat-count {
  font-size: 22rpx;
  color: #94a3b8;
}

.text-income { color: #16a34a; }
.text-expense { color: #ea580c; }

/* ========== Tab 切换 ========== */

.tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.2s;
}

.tab.active {
  background: rgba(186, 230, 253, 0.7);
  color: #0284c7;
  font-weight: 600;
}

/* ========== 记录列表 ========== */

.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 1000rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.record-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.record-cat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bg-income { background: rgba(187, 247, 208, 0.6); }
.bg-expense { background: rgba(254, 215, 170, 0.6); }

.record-info {
  flex: 1;
  overflow: hidden;
}

.record-cat {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
}

.record-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.record-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(186, 230, 253, 0.35);
  font-size: 22rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.record-tag:active {
  background: rgba(125, 211, 252, 0.5);
  transform: scale(0.95);
}

.record-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.record-del {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(251, 113, 133, 0.15);
  color: #fb7185;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* ========== 空状态 ========== */

.empty-section {
  text-align: center;
  padding: 80rpx 0;
}

.empty-illustration {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #cbd5e1;
  font-size: 26rpx;
}

/* ========== 饼状图 ========== */

.chart-card {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(135, 206, 235, 0.15);
  padding: 28rpx;
  margin-top: 16rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 20rpx;
}

.chart-container {
  display: flex;
  align-items: center;
}

.pie-canvas {
  width: 300rpx;
  height: 300rpx;
  flex-shrink: 0;
  display: block;
}

.chart-legend {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-label {
  font-size: 26rpx;
  color: #475569;
  min-width: 80rpx;
}

.legend-value {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}

.legend-percent {
  font-size: 24rpx;
  color: #94a3b8;
  margin-left: auto;
}

.legend-sub {
  margin-top: 4rpx;
  padding-left: 24rpx;
}

.legend-sub-text {
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.4;
}

/* ========== 文本输入弹窗 ========== */

.text-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.text-modal-card {
  width: 600rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(135, 206, 235, 0.2);
  padding: 36rpx 32rpx 28rpx;
}

.text-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #475569;
  text-align: center;
  margin-bottom: 24rpx;
}

.text-modal-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: rgba(241, 245, 249, 0.6);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #334155;
  line-height: 1.5;
}

.text-modal-placeholder {
  color: #cbd5e1;
  font-size: 28rpx;
}

.text-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.text-modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.text-modal-cancel {
  background: rgba(241, 245, 249, 0.8);
  color: #64748b;
}

.text-modal-cancel:active {
  transform: scale(0.95);
}

.text-modal-confirm {
  background: linear-gradient(135deg, #7dd3fc, #38bdf8);
  color: #fff;
}

.text-modal-confirm:active {
  transform: scale(0.95);
}
