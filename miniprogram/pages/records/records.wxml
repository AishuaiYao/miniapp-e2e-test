<view class="page">
  <view class="bg-gradient"></view>

  <scroll-view scroll-y class="content-scroll">
    <!-- 概览 -->
    <view class="section stats-section" wx:if="{{records.length > 0}}">
      <view class="stats-cards">
        <view class="stat-card income-card">
          <text class="stat-label">收入</text>
          <text class="stat-amount">¥{{totalIncome}}</text>
        </view>
        <view class="stat-card expense-card">
          <text class="stat-label">支出</text>
          <text class="stat-amount">¥{{totalExpense}}</text>
        </view>
        <view class="stat-card balance-card">
          <text class="stat-label">结余</text>
          <text class="stat-amount">¥{{balance}}</text>
        </view>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="section list-section" wx:if="{{records.length > 0}}">
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-item-left">
            <view class="record-cat-icon {{item.type === 'income' ? 'bg-income' : 'bg-expense'}}">
              <image wx:if="{{item.categoryIcon}}" class="cat-icon-img" src="{{item.categoryIcon}}" mode="aspectFit"></image>
              <text wx:else>{{item.type === 'income' ? '💰' : '🧾'}}</text>
            </view>
            <view class="record-info">
              <view class="record-cat">{{item.category}}{{item.subCategory ? ' · ' + item.subCategory : ''}}</view>
              <view class="record-desc">{{item.description}}</view>
              <view class="record-tags">
                <view class="record-tag">{{item.time}}</view>
                <view wx:if="{{item.location}}" class="record-tag"><image class="tag-icon" src="/images/定位.png" mode="aspectFit"></image>{{item.location}}</view>
              </view>
            </view>
          </view>
          <view class="record-item-right">
            <text class="record-amount {{item.type === 'income' ? 'text-income' : 'text-expense'}}">
              {{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}
            </text>
            <view class="record-del" catchtap="onDeleteRecord" data-id="{{item.id}}">✕</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="section empty-section" wx:if="{{records.length === 0}}">
      <view class="empty-illustration">📝</view>
      <text class="empty-text">没有相关记录</text>
    </view>

    <view style="height: 60rpx;"></view>
  </scroll-view>
</view>
