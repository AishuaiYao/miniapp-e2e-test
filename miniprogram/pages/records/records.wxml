<view class="page">
  <view class="bg-gradient"></view>

  <scroll-view scroll-y class="content-scroll">
    <!-- 概览 -->
    <view class="section stats-section" wx:if="{{records.length > 0}}">
      <view class="stats-cards">
        <view class="stat-card income-card">
          <text class="stat-label">收入</text>
          <text class="stat-amount">¥{{totalIncome}}</text>
        </view>
        <view class="stat-card expense-card">
          <text class="stat-label">支出</text>
          <text class="stat-amount">¥{{totalExpense}}</text>
        </view>
        <view class="stat-card balance-card">
          <text class="stat-label">结余</text>
          <text class="stat-amount">¥{{balance}}</text>
        </view>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="section list-section" wx:if="{{records.length > 0}}">
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-item-left">
            <view class="record-cat-icon {{item.type === 'income' ? 'bg-income' : 'bg-expense'}}">
              <image wx:if="{{item.categoryIcon}}" class="cat-icon-img" src="{{item.categoryIcon}}" mode="aspectFit"></image>
              <text wx:else>{{item.type === 'income' ? '💰' : '🧾'}}</text>
            </view>
            <view class="record-info">
              <view class="record-cat">{{item.category}}{{item.subCategory ? ' · ' + item.subCategory : ''}}</view>
              <view class="record-desc">{{item.description}}</view>
              <view class="record-tags">
                <view class="record-tag">
                  <text>{{item.time}}</text>
                  <text class="tag-edit" catchtap="onEditDate" data-id="{{item._id}}" data-time="{{item.time}}">✎</text>
                </view>
                <view wx:if="{{item.location}}" class="record-tag">
                  <image class="tag-icon" src="/images/定位.png" mode="aspectFit"></image>
                  <text>{{item.location}}</text>
                  <text class="tag-edit" catchtap="onEditLocation" data-id="{{item._id}}" data-location="{{item.location}}">✎</text>
                </view>
              </view>
            </view>
          </view>
          <view class="record-item-right">
            <text class="record-amount {{item.type === 'income' ? 'text-income' : 'text-expense'}}">
              {{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}
            </text>
            <view class="record-del" catchtap="onDeleteRecord" data-id="{{item.id}}">✕</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="section empty-section" wx:if="{{records.length === 0}}">
      <view class="empty-illustration">📝</view>
      <text class="empty-text">没有相关记录</text>
    </view>

    <view style="height: 60rpx;"></view>
  </scroll-view>

  <!-- 修改地点弹窗 -->
  <view class="location-edit-mask" wx:if="{{locationEditVisible}}" catchtap="closeLocationEdit">
    <view class="location-edit-card" catchtap="onModalStop">
      <text class="location-edit-title">修改地点</text>
      <input class="location-edit-input" value="{{locationEditValue}}" bindinput="onLocationInput" placeholder="请输入地点" maxlength="50"></input>
      <view class="location-edit-actions">
        <view class="location-edit-cancel" catchtap="closeLocationEdit">取消</view>
        <view class="location-edit-confirm" catchtap="confirmLocationEdit">确认</view>
      </view>
    </view>
  </view>

  <!-- 修改日期弹窗 -->
  <view class="date-edit-mask" wx:if="{{dateEditVisible}}" catchtap="closeDateEdit">
    <view class="date-edit-card" catchtap="onModalStop">
      <text class="date-edit-title">修改日期</text>
      <picker mode="date" value="{{dateEditValue}}" bindchange="onDateChange">
        <view class="date-picker-value">{{dateEditValue}}</view>
      </picker>
      <view class="date-edit-actions">
        <view class="date-edit-cancel" catchtap="closeDateEdit">取消</view>
        <view class="date-edit-confirm" catchtap="confirmDateEdit">确认</view>
      </view>
    </view>
  </view>
</view>
