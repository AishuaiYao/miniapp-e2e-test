page {
  background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 30%, #fef3f2 70%, #fce7f3 100%);
  min-height: 100vh;
}

.page {
  position: relative;
  min-height: 100vh;
}

.bg-gradient {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(224, 242, 254, 0.4) 0%, rgba(252, 231, 243, 0.4) 100%);
  z-index: 0;
}

.content-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.section {
  padding: 16rpx 24rpx;
}

/* 概览 */
.stats-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
}

.income-card { background: rgba(187, 247, 208, 0.5); }
.expense-card { background: rgba(254, 215, 170, 0.5); }
.balance-card { background: rgba(186, 230, 253, 0.5); }

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.stat-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #334155;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(135, 206, 235, 0.1);
}

.record-item-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.record-cat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.cat-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.bg-income { background: rgba(187, 247, 208, 0.6); }
.bg-expense { background: rgba(254, 215, 170, 0.6); }

.record-info {
  flex: 1;
  overflow: hidden;
}

.record-cat-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.record-cat {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
}

.record-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.record-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(186, 230, 253, 0.35);
  font-size: 22rpx;
  color: #64748b;
  gap: 4rpx;
}

.tag-edit {
  color: #a78bfa;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.date-edit-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.4);
}

.date-edit-card {
  width: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
}

.date-edit-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 24rpx;
}

.date-picker-value {
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(186, 230, 253, 0.35);
  color: #64748b;
  font-size: 30rpx;
}

.date-edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.date-edit-cancel,
.date-edit-confirm {
  flex: 1;
  padding: 20rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.date-edit-cancel {
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
}

.date-edit-confirm {
  color: #fff;
  background: linear-gradient(135deg, #7dd3fc, #38bdf8);
}

.location-edit-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.4);
}

.location-edit-card {
  width: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
}

.location-edit-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 24rpx;
}

.location-edit-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: rgba(241, 245, 249, 0.7);
  color: #334155;
  font-size: 30rpx;
  line-height: 80rpx;
}

.location-edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.location-edit-cancel,
.location-edit-confirm {
  flex: 1;
  padding: 20rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.location-edit-cancel {
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
}

.location-edit-confirm {
  color: #fff;
  background: linear-gradient(135deg, #c4b5fd, #a78bfa);
}

.image-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.5);
}

.image-preview-card {
  position: relative;
  width: 600rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
}

.image-preview-actions {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 2;
  display: flex;
  gap: 12rpx;
}

.image-preview-change,
.image-preview-delete {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 24rpx;
}

.image-preview-change {
  background: linear-gradient(135deg, #c4b5fd, #a78bfa);
}

.image-preview-delete {
  background: linear-gradient(135deg, #fda4af, #fb7185);
}

.image-preview-img {
  width: 100%;
  height: 600rpx;
  border-radius: 16rpx;
}

.tag-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.record-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-image-btn {
  padding: 6rpx 10rpx;
  border-radius: 16rpx;
  color: #7c3aed;
  background: rgba(221, 214, 254, 0.5);
  font-size: 20rpx;
}

.record-image-thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: rgba(241, 245, 249, 0.8);
}

.record-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.text-income { color: #22c55e; }
.text-expense { color: #f43f5e; }

.record-del {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(251, 113, 133, 0.15);
  color: #fb7185;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 空状态 */
.empty-section {
  text-align: center;
  padding: 80rpx 0;
}

.empty-illustration {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #64748b;
}
